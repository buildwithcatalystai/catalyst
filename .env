# Catalyst plugin configuration — committed defaults.
# These values point at the public Catalyst deployment; no setup needed.
# To override locally, set the same vars in your shell env before launching
# Claude Code (e.g. `export CATALYST_BACKEND_URL=http://localhost:8000`).
#
# No secrets here. The hook authenticates to the wizard backend via the
# events_jwt minted in catalyst-mcp's start_coding / enter_coding_mode
# responses (see /api/events/record on the backend). The plugin only
# needs URLs to know which deployment to talk to.

# URL where catalyst-mcp accepts MCP requests — through the control plane's front door
# (nginx behind Caddy on 443). The raw :9000 port is closed since 2026-09-16.
CATALYST_MCP_URL=https://buildwithcatalyst.ai/mcp

# URL where the catalyst-builder wizard backend lives. The PostToolUse
# hook POSTs turn records to {CATALYST_BACKEND_URL}/api/events/record/
# {session_id} authenticated by the events_jwt, so they show up live in
# ChatPane and persist to the PostgresSaver checkpoint. Through the front door on 443 —
# the raw :8000 port is closed since 2026-09-16 (a hook pointed at it hangs past Claude
# Code's 10 s hook budget: "UserPromptSubmit hook timed out after 10s").
CATALYST_BACKEND_URL=https://buildwithcatalyst.ai
