{
  "description": "Catalyst plugin hooks: PreToolUse guard + PostToolUse/Stop/UserPromptSubmit event sink + the status line (SessionStart installs it, Pre/PostToolUse feed it). The status line entries run `sh statusline_hook.sh …; exit 0`: the launcher picks node, else python3, else nothing; the trailing `exit 0` keeps a machine without `sh` (Windows without Git Bash, where hooks run in PowerShell) quiet too — stderr of a hook that exits 0 goes to the debug log only, never the transcript.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/statusline_hook.sh\" install; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/catalyst-block-native.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*catalyst-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/statusline_hook.sh\" capture; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook_record.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*catalyst-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/statusline_hook.sh\" capture; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook_record.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook_record.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
